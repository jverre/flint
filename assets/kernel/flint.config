# Flint's additions to Firecracker's CI guest config (see scripts/build-kernel.sh).
# One kernel for both backends: Firecracker (virtio-mmio) and Cloud
# Hypervisor (PVH boot, virtio-pci).
CONFIG_PVH=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
# Shared volumes are mounted over NFSv3 from Flint's host NFS server;
# exclusive volumes are block devices over NBD from the same server.
CONFIG_BLK_DEV_NBD=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
# Filesystems users mount themselves, and future volume transports.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
