# /etc/flint/flint.env — read by every Flint unit. Terraform's flint-cloudinit
# module writes this file; on hand-built machines, copy and edit it.

# ── Shared ─────────────────────────────────────────────────────────────────
# Snapshot store: same URL on the control plane and every host.
FLINT_STORE_URL=s3://my-flint-bucket/snapshots
# AWS_REGION=us-east-1
# Static S3 keys (omit on clouds with instance roles):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Control plane (flint-server) ───────────────────────────────────────────
# FLINT_DATABASE_URL=postgres://flint:...@db.internal:5432/flint?sslmode=require
# FLINT_LISTEN=:9300
# FLINT_HOST_LISTEN=:9301
# FLINT_HOST_ENDPOINT=https://flint-hosts.internal:9301
# FLINT_ADMIN_TOKEN=
# FLINT_JOIN_SECRET=          # reusable join secret for autoscaling groups
# FLINT_CP_CA_CERT=/etc/flint/cp-ca.crt
# FLINT_CP_CA_KEY=/etc/flint/cp-ca.key
# FLINT_HOSTS_CA_CERT=/etc/flint/hosts-ca.crt
# FLINT_HOSTS_CA_KEY=/etc/flint/hosts-ca.key

# ── Host (flint agent + flint-cluster snapd) ───────────────────────────────
# FLINT_JOIN_TOKEN=flintjoin1....   # only needed until the host has joined
# FLINT_ADVERTISE_ADDR=10.0.1.23    # "auto" = first address of the default route
# FLINT_ZONE=us-east-1a
# FLINT_BACKEND=firecracker
# FLINT_PORT=9400
# FLINT_SNAPD_PEER_LISTEN=:9501
# FLINT_SNAPD_SOCKET=/run/flint/snapd.sock
# FLINT_SNAPSHOT_CACHE=/var/lib/flint/snapshot-cache
# FLINT_WATCHDOG_DEVICE=/dev/watchdog

# Fleet maintenance: pin the image, exact host kernel flavour and VMM release.
# FLINT_HOST_IMAGE=approved-image-id
# FLINT_HOST_KERNEL=exact-running-kernel-release
# FLINT_HYPERVISOR_VERSION=explicit-release
# FLINT_ROLLOUT_GROUP=canary
# Reserve these resources on each compatible host for evacuation.
# FLINT_RESERVE_VCPUS=2
# FLINT_RESERVE_MEMORY_MB=2048
# FLINT_RESERVE_DISK_MB=10240

# Migratable Cloud Hypervisor hosts (all must share the same POSIX pool).
# Mount NFSv4/Ceph first, then initialise its root-owned pool.json UUID once.
# FLINT_SHARED_ROOTFS_DIR=/srv/flint-root-disks
# FLINT_MIGRATION_LOCAL_IP=10.90.0.11
# FLINT_MIGRATION_GATEWAY_IP=10.90.0.1
# FLINT_MIGRATION_GATEWAY_API=https://gateway.internal:9600
# FLINT_MIGRATION_UNDERLAY=wg-flint
# FLINT_MIGRATION_MTU=1500
# Dedicated gateway only: provision its host identity and WireGuard peers first.
# FLINT_MIGRATION_PEERS=10.90.0.11,10.90.0.12
# FLINT_GATEWAY_STATE_DIR=/var/lib/flint/gateway
# Optional: use only after validating kernel/VMM pairs with real migrations,
# checkpoint restores and workload continuity on your canary group.
# FLINT_MIGRATION_COMPATIBILITY_GROUP=validated-october-rollout
# FLINT_CH_MIGRATION_ALLOWED_PAIRS=46.0>47.0
